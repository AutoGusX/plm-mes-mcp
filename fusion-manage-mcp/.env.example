# Fusion Manage tenant name (subdomain of your PLM instance)
FUSION_MANAGE_TENANT=mycompany

# Static 3-legged APS access token — for local development only
# Obtain via APS OAuth Authorization Code flow
FUSION_MANAGE_TOKEN=

# APS App credentials (used when running OAuth flow locally)
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Gateway secret injected by Apigee in production (x-ads-gateway-secret header)
ADS_GATEWAY_SECRET=

# Set to true for local dev (skips gateway secret validation)
DEV_MODE=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server bind settings
HOST=0.0.0.0
PORT=8000
