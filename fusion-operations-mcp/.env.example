# Fusion Operations API credentials
# Obtain from your Fusion Operations admin panel
FUSION_OPS_API_KEY=
FUSION_OPS_API_SECRET=

# Gateway secret injected by Apigee in production (x-ads-gateway-secret header)
ADS_GATEWAY_SECRET=

# Set to true for local dev (skips gateway secret validation)
DEV_MODE=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server bind settings
HOST=0.0.0.0
PORT=8001
